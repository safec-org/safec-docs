// safec-site — builds a PageView: every piece of a page's chrome (nav,
// sidebar, outline, prev/next, breadcrumbs, language menu, footer, the
// playground app) as finished HTML, so the scx templates only interpolate.
//
// Layouts (frontmatter 'layout'):
//   doc         docs: sidebar, outline, breadcrumbs, version selector (default)
//   home        the landing page: full-width sections from layout containers
//   page        a wide single column (Learn, Install, Tools, Community, Changelog)
//   blog        a blog listing (generated by blog.sc)
//   post        a blog post: title, date/author/tags, newer/older links
//   playground  the editor + output app around the page's own text
#include "site.h"
#include <std/serial/json.h>

static void href(const &Site site, &String out, const &char link) {
    out.push(" href=\"");
    struct String r = String::new();
    link_rewrite(site, link, &r);
    util_push_esc(out, r.as_ptr());
    r.free();
    out.push("\"");
}

static int is_external(const &char link) {
    struct String l = String::from(link);
    int ext = l.starts_with("http://") || l.starts_with("https://");
    l.free();
    return ext;
}

static int same_route(const &char link, const &Page page) {
    return page.route.eq_cstr(link);
}

// An item's 'match' list: route prefixes under which it is the current section.
static int matches_prefix(const &Value it, const &Page page) {
    ?&Value m = it.object_get("match");
    match (m) {
        case some(list): {
            for (unsigned long i = 0UL; list.kind_of() == VAL_ARRAY && i < list.array_len(); i = i + 1UL) {
                &Value e = list.array_at(i);
                if (e.kind_of() == VAL_STRING && page.route.starts_with(e.as_string())) { return 1; }
            }
        }
        case null: { }
    }
    return 0;
}

static int group_has_route(const &Value group, const &Value items, const &Page page) {
    if (matches_prefix(group, page)) { return 1; }
    if (items.kind_of() != VAL_ARRAY) { return 0; }
    for (unsigned long i = 0UL; i < items.array_len(); i = i + 1UL) {
        if (same_route(util_vstr(items.array_at(i), "link", ""), page)) { return 1; }
    }
    return 0;
}

static const &char lbl(const &Locale loc, const &char key, const &char fallback) {
    ?&Value lv = loc.data.object_get("labels");
    match (lv) { case some(l): { return util_vstr(l, key, fallback); } case null: { } }
    return fallback;
}

static void link_item(const &Site site, const &Value it, const &Page page, const &char cls, &String out) {
    const &char link = util_vstr(it, "link", "");
    out.push("<a class=\"");
    out.push(cls);
    int active = same_route(link, page) || matches_prefix(it, page);
    if (active) { out.push(" active"); }
    if (!util_empty(util_vstr(it, "style", ""))) { out.push(" "); util_push_esc(out, util_vstr(it, "style", "")); }
    out.push("\"");
    href(site, out, link);
    if (active) { out.push(" aria-current=\"page\""); }
    if (is_external(link)) { out.push(" target=\"_blank\" rel=\"noreferrer\""); }
    out.push(">");
    util_push_esc(out, util_vstr(it, "text", ""));
    out.push("</a>");
}

static void build_nav(const &Site site, const &Locale loc, const &Page page, &String out) {
    ?&Value nav = loc.data.object_get("nav");
    match (nav) {
        case some(items): {
            for (unsigned long i = 0UL; i < items.array_len(); i = i + 1UL) {
                &Value it = items.array_at(i);
                ?&Value sub = it.object_get("items");
                match (sub) {
                    case some(s): {
                        out.push("<div class=\"nav-group");
                        if (group_has_route(it, s, page)) { out.push(" active"); }
                        out.push("\"><button class=\"nav-group-btn\" type=\"button\" aria-expanded=\"false\">");
                        util_push_esc(out, util_vstr(it, "text", ""));
                        out.push("<span class=\"caret\"></span></button><div class=\"nav-menu\">");
                        for (unsigned long k = 0UL; k < s.array_len(); k = k + 1UL) {
                            link_item(site, s.array_at(k), page, "nav-menu-link", out);
                        }
                        out.push("</div></div>");
                    }
                    case null: {
                        // The GitHub entry is rendered as an icon by the template.
                        if (!is_external(util_vstr(it, "link", ""))) { link_item(site, it, page, "nav-link", out); }
                    }
                }
            }
        }
        case null: { }
    }
}

// The locale's sidebar entry whose 'prefix' is the longest prefix of the route.
static ?&Value sidebar_entry(const &Locale loc, const &Page page) {
    ?&Value best = (?&Value)null;
    unsigned long best_len = 0UL;
    ?&Value sb = loc.data.object_get("sidebar");
    match (sb) {
        case some(s): {
            for (unsigned long i = 0UL; i < s.array_len(); i = i + 1UL) {
                &Value e = s.array_at(i);
                const &char prefix = util_vstr(e, "prefix", "");
                struct String p = String::from(prefix);
                if (p.len > best_len && page.route.starts_with(prefix)) {
                    best = e;
                    best_len = p.len;
                }
                p.free();
            }
        }
        case null: { }
    }
    return best;
}

static ?&Value sidebar_for(const &Locale loc, const &Page page) {
    ?&Value e = sidebar_entry(loc, page);
    match (e) { case some(x): { return x.object_get("groups"); } case null: { } }
    return (?&Value)null;
}

static void build_sidebar(const &Site site, const &Locale loc, const &Page page, &String out) {
    ?&Value groups = sidebar_for(loc, page);
    match (groups) {
        case some(gs): {
            for (unsigned long g = 0UL; g < gs.array_len(); g = g + 1UL) {
                &Value grp = gs.array_at(g);
                out.push("<section class=\"sb-group\"><p class=\"sb-title\">");
                util_push_esc(out, util_vstr(grp, "text", ""));
                out.push("</p><ul>");
                ?&Value items = grp.object_get("items");
                match (items) {
                    case some(its): {
                        for (unsigned long k = 0UL; k < its.array_len(); k = k + 1UL) {
                            out.push("<li>");
                            link_item(site, its.array_at(k), page, "sb-link", out);
                            out.push("</li>");
                        }
                    }
                    case null: { }
                }
                out.push("</ul></section>");
            }
        }
        case null: { }
    }
}

// Learn › <section> › <page>, for doc pages.
static void build_crumbs(const &Site site, const &Locale loc, const &Page page, &String out) {
    ?&Value e = sidebar_entry(loc, page);
    match (e) {
        case some(entry): {
            struct String learn = loc.prefix.clone();
            learn.push("learn/");
            out.push("<nav class=\"crumbs\" aria-label=\"");
            util_push_esc(out, lbl(loc, "breadcrumbs", "Breadcrumbs"));
            out.push("\"><a");
            href(site, out, learn.as_ptr());
            out.push(">");
            util_push_esc(out, lbl(loc, "learn", "Learn"));
            out.push("</a><span class=\"sep\" aria-hidden=\"true\">/</span>");
            learn.free();
            // The section: its 'name' (or first group's title), linking its first page.
            const &char name = util_vstr(entry, "name", "");
            const &char first = "";
            ?&Value gs = entry.object_get("groups");
            match (gs) {
                case some(g): {
                    if (g.array_len() > 0UL) {
                        if (util_empty(name)) { name = util_vstr(g.array_at(0UL), "text", ""); }
                        ?&Value its = g.array_at(0UL).object_get("items");
                        match (its) { case some(x): { if (x.array_len() > 0UL) { first = util_vstr(x.array_at(0UL), "link", ""); } } case null: { } }
                    }
                }
                case null: { }
            }
            out.push("<a");
            href(site, out, first);
            out.push(">");
            util_push_esc(out, name);
            out.push("</a>");
            if (!same_route(first, page)) {
                out.push("<span class=\"sep\" aria-hidden=\"true\">/</span><span aria-current=\"page\">");
                util_push_esc(out, page.title.as_ptr());
                out.push("</span>");
            }
            out.push("</nav>");
        }
        case null: { }
    }
}

// Docs version selector: today one set of docs (main); released versions
// are listed as coming soon until per-version docs are published.
static void build_version_menu(const &Site site, const &Locale loc, &String out) {
    out.push("<div class=\"nav-group version-select\"><button class=\"nav-group-btn\" type=\"button\" aria-expanded=\"false\" aria-label=\"");
    util_push_esc(out, lbl(loc, "docsVersion", "Documentation version"));
    out.push("\"><span class=\"v-label\">");
    util_push_esc(out, lbl(loc, "docsVersionShort", "Docs"));
    out.push("</span> <span class=\"v-current\">main</span><span class=\"caret\"></span></button><div class=\"nav-menu\"><span class=\"nav-menu-link active\">main <small>");
    util_push_esc(out, lbl(loc, "docsLatest", "development (latest)"));
    out.push("</small></span>");
    for (unsigned long i = 0UL; i < site.versions.len; i = i + 1UL) {
        out.push("<span class=\"nav-menu-link disabled\" aria-disabled=\"true\">");
        util_push_esc(out, site.versions.at(i).as_ptr());
        out.push(" <small>");
        util_push_esc(out, lbl(loc, "docsSoon", "coming soon"));
        out.push("</small></span>");
    }
    out.push("</div></div>");
}

static void build_prev_next(const &Site site, const &Locale loc, const &Page page, &String out) {
    ?&Value groups = sidebar_for(loc, page);
    struct Vec<&Value> flat = Vec::new();
    match (groups) {
        case some(gs): {
            for (unsigned long g = 0UL; g < gs.array_len(); g = g + 1UL) {
                ?&Value items = gs.array_at(g).object_get("items");
                match (items) {
                    case some(its): {
                        for (unsigned long k = 0UL; k < its.array_len(); k = k + 1UL) { flat.push(its.array_at(k)); }
                    }
                    case null: { }
                }
            }
        }
        case null: { }
    }
    long long at = -1LL;
    for (unsigned long i = 0UL; i < flat.len; i = i + 1UL) {
        if (same_route(util_vstr(*flat.at(i), "link", ""), page)) { at = (long long)i; }
    }
    if (at < 0LL) { flat.free(); return; }
    out.push("<nav class=\"prev-next\">");
    if (at > 0LL) {
        &Value p = *flat.at((unsigned long)at - 1UL);
        out.push("<a class=\"pager prev\"");
        href(site, out, util_vstr(p, "link", ""));
        out.push("><span class=\"desc\">");
        util_push_esc(out, lbl(loc, "prev", "Previous page"));
        out.push("</span><span class=\"title\">");
        util_push_esc(out, util_vstr(p, "text", ""));
        out.push("</span></a>");
    } else {
        out.push("<span></span>");
    }
    if ((unsigned long)at + 1UL < flat.len) {
        &Value n = *flat.at((unsigned long)at + 1UL);
        out.push("<a class=\"pager next\"");
        href(site, out, util_vstr(n, "link", ""));
        out.push("><span class=\"desc\">");
        util_push_esc(out, lbl(loc, "next", "Next page"));
        out.push("</span><span class=\"title\">");
        util_push_esc(out, util_vstr(n, "text", ""));
        out.push("</span></a>");
    }
    out.push("</nav>");
    flat.free();
}

// frontmatter 'outline': absent -> [2, 2]; "[2, 4]" -> 2..4; "deep" -> 2..6; N -> N..N.
static void outline_range(const &Page page, &int lo, &int hi) {
    *lo = 2; *hi = 2;
    ?&Value o = page.front.object_get("outline");
    match (o) {
        case some(v): {
            if (v.kind_of() == VAL_INT) { *lo = (int)v.as_int(); *hi = *lo; }
            else if (v.kind_of() == VAL_ARRAY && v.array_len() == 2UL) {
                *lo = (int)v.array_at(0UL).as_int();
                *hi = (int)v.array_at(1UL).as_int();
            }
            else if (v.kind_of() == VAL_STRING) {
                struct String s = String::from(v.as_string());
                if (s.eq_cstr("deep")) { *hi = 6; }
                s.free();
            }
        }
        case null: { }
    }
}

static void build_toc(const &Page page, &String out) {
    int lo = 2;
    int hi = 2;
    outline_range(page, &lo, &hi);
    for (unsigned long i = 0UL; i < page.headings.len; i = i + 1UL) {
        &Heading h = page.headings.at(i);
        if (h.level < lo || h.level > hi) { continue; }
        out.push("<li class=\"toc-l");
        out.push_int((long long)(h.level - lo));
        out.push("\"><a href=\"#");
        util_push_esc(out, h.id.as_ptr());
        out.push("\">");
        util_push_esc(out, h.text.as_ptr());
        out.push("</a></li>");
    }
}

static int route_exists(const &Vec<struct Page> pages, const &String route) {
    for (unsigned long i = 0UL; i < pages.len; i = i + 1UL) {
        if (pages.at(i).route.eq(route)) { return 1; }
    }
    return 0;
}

static void build_locale_menu(const &Site site, const &Vec<struct Page> pages, unsigned long li, const &Page page, &String out) {
    &Locale cur = site.locales.at(li);
    // The page's route with the current locale's prefix stripped.
    struct String tail = page.route.substr(cur.prefix.len, page.route.len);
    for (unsigned long k = 0UL; k < site.locales.len; k = k + 1UL) {
        &Locale l = site.locales.at(k);
        struct String target = l.prefix.clone();
        target.push_str(&tail);
        // Untranslated page: the other locale's home instead of a 404.
        if (!route_exists(pages, &target)) { target.clear(); target.push_str(&l.prefix); }
        out.push("<a class=\"locale-link");
        if (k == li) { out.push(" active"); }
        out.push("\" lang=\"");
        util_push_esc(out, util_vstr(&l.data, "lang", ""));
        out.push("\"");
        href(site, out, target.as_ptr());
        out.push(">");
        util_push_esc(out, util_vstr(&l.data, "label", ""));
        out.push("</a>");
        target.free();
    }
    tail.free();
}

static void build_head(const &Site site, const &Locale loc, const ?&Page page, &String out) {
    ?&Value head = site.cfg.object_get("head");
    match (head) {
        case some(h): {
            for (unsigned long i = 0UL; i < h.array_len(); i = i + 1UL) {
                &Value e = h.array_at(i);
                out.push("<link");
                for (unsigned long k = 0UL; k < e.object_len(); k = k + 1UL) {
                    struct String ks = String::from(e.object_key_at(k));
                    if (!ks.eq_cstr("tag")) {
                        out.push(" ");
                        out.push_str(&ks);
                        out.push("=\"");
                        if (ks.eq_cstr("href")) { out.push(site.base.as_ptr()); }
                        util_push_esc(out, e.object_value_at(k).as_string());
                        out.push("\"");
                    }
                    ks.free();
                }
                out.push(">\n");
            }
        }
        case null: { }
    }
    // The locale's blog feeds, on every page (feed readers find them).
    struct String feed = loc.prefix.clone();
    feed.push("blog/feed.xml");
    out.push("<link rel=\"alternate\" type=\"application/atom+xml\" title=\"");
    util_push_esc(out, util_vstr(&loc.data, "title", "SafeC"));
    out.push(" Blog\"");
    href(site, out, feed.as_ptr());
    out.push(">\n");
    feed.free();
    match (page) {
        case some(p): {
            out.push("<link rel=\"canonical\" href=\"");
            util_push_esc(out, util_vstr(&site.cfg, "origin", ""));
            struct String u = String::new();
            link_rewrite(site, p.route.as_ptr(), &u);
            util_push_esc(out, u.as_ptr());
            u.free();
            out.push("\">\n");
            // Open Graph basics for link previews.
            out.push("<meta property=\"og:title\" content=\"");
            util_push_esc(out, p.title.as_ptr());
            out.push("\">\n<meta property=\"og:type\" content=\"");
            out.push(blog_is_post(site, p) ? "article" : "website");
            out.push("\">\n");
        }
        case null: { }
    }
}

static void build_footer_cols(const &Site site, const &Locale loc, const &Page page, &String out) {
    ?&Value footer = loc.data.object_get("footer");
    match (footer) {
        case some(f): {
            ?&Value cols = f.object_get("columns");
            match (cols) {
                case some(cs): {
                    for (unsigned long i = 0UL; i < cs.array_len(); i = i + 1UL) {
                        &Value col = cs.array_at(i);
                        out.push("<div class=\"f-col\"><p class=\"f-title\">");
                        util_push_esc(out, util_vstr(col, "title", ""));
                        out.push("</p><ul>");
                        ?&Value items = col.object_get("items");
                        match (items) {
                            case some(its): {
                                for (unsigned long k = 0UL; k < its.array_len(); k = k + 1UL) {
                                    out.push("<li>");
                                    link_item(site, its.array_at(k), page, "f-link", out);
                                    out.push("</li>");
                                }
                            }
                            case null: { }
                        }
                        out.push("</ul></div>");
                    }
                }
                case null: { }
            }
        }
        case null: { }
    }
}

// ── blog posts ───────────────────────────────────────────────────────────────

static void post_nav_link(const &Site site, const &Page page, const &char key, const &char cls, const &char desc, &String out) {
    ?&Value n = page.front.object_get(key);
    match (n) {
        case some(x): {
            out.push("<a class=\"pager ");
            out.push(cls);
            out.push("\"");
            href(site, out, util_vstr(x, "route", "/"));
            out.push("><span class=\"desc\">");
            util_push_esc(out, desc);
            out.push("</span><span class=\"title\">");
            util_push_esc(out, util_vstr(x, "title", ""));
            out.push("</span></a>");
        }
        case null: { out.push("<span></span>"); }
    }
}

static void build_post(const &Site site, const &Locale loc, const &Page page, &String out) {
    out.push("<article class=\"post\"><header class=\"post-head\"><p class=\"post-kicker\"><a");
    struct String bp = loc.prefix.clone();
    bp.push("blog/");
    href(site, out, bp.as_ptr());
    out.push(">");
    ?&Value b = loc.data.object_get("blog");
    const &char blog_title = "Blog";
    match (b) { case some(x): { blog_title = util_vstr(x, "title", "Blog"); } case null: { } }
    util_push_esc(out, blog_title);
    out.push("</a></p><h1 class=\"post-title\">");
    util_push_esc(out, page.title.as_ptr());
    out.push("</h1>");
    blog_post_meta(site, page, out);
    out.push("</header><div class=\"vp-doc post-body\">");
    out.push_str(&page.html);
    out.push("</div><nav class=\"prev-next post-nav\">");
    post_nav_link(site, page, "_newer", "prev", lbl(loc, "newerPost", "Newer post"), out);
    post_nav_link(site, page, "_older", "next", lbl(loc, "olderPost", "Older post"), out);
    out.push("</nav></article>");
    bp.free();
}

// ── playground ───────────────────────────────────────────────────────────────

static const &char pg(const &Locale loc, const &char key, const &char fallback) {
    ?&Value p = loc.data.object_get("playground");
    match (p) { case some(x): { return util_vstr(x, key, fallback); } case null: { } }
    return fallback;
}

static void push_lines(&String out, const &String code) {
    unsigned long n = 1UL;
    for (unsigned long i = 0UL; i + 1UL < code.len; i = i + 1UL) { if (code.char_at(i) == (int)'\n') { n = n + 1UL; } }
    for (unsigned long i = 1UL; i <= n; i = i + 1UL) {
        out.push_int((long long)i);
        out.push_char('\n');
    }
}

