    out.push("</a></div>");
    out.push("<noscript><div class=\"pg-notice\">");
    util_push_esc(out, pg(loc, "noscript", "The playground needs JavaScript."));
    out.push("</div></noscript>");
    // editor + output
    out.push("<div class=\"pg-main\"><div class=\"pg-editor\"><pre class=\"pg-gutter\" id=\"pg-gutter\" aria-hidden=\"true\">");
    push_lines(out, &code);
    out.push("</pre><div class=\"pg-code\"><pre class=\"pg-hl\" aria-hidden=\"true\"><code id=\"pg-hl\">");
    highlight_code("c", code.as_ptr(), code.len, out);
    out.push("\n</code></pre><textarea id=\"pg-src\" spellcheck=\"false\" autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" wrap=\"off\" aria-label=\"");
    util_push_esc(out, pg(loc, "editorLabel", "SafeC source code"));
    out.push("\" aria-describedby=\"pg-keys\">");
    util_push_esc(out, code.as_ptr());
    out.push("</textarea></div></div><div class=\"pg-side\"><div class=\"pg-tabs\" role=\"tablist\"><button type=\"button\" role=\"tab\" class=\"pg-tab active\" aria-selected=\"true\" data-pane=\"out\">");
    util_push_esc(out, pg(loc, "output", "Output"));
    out.push("</button><button type=\"button\" role=\"tab\" class=\"pg-tab\" aria-selected=\"false\" data-pane=\"diag\">");
    util_push_esc(out, pg(loc, "diagnostics", "Diagnostics"));
    out.push(" <span class=\"pg-count\" id=\"pg-diag-count\"></span></button></div><pre class=\"pg-pane active\" id=\"pg-out\" data-pane=\"out\" tabindex=\"0\" aria-label=\"");
    util_push_esc(out, pg(loc, "output", "Output"));
    out.push("\"></pre><ul class=\"pg-pane\" id=\"pg-diag\" data-pane=\"diag\" aria-label=\"");
    util_push_esc(out, pg(loc, "diagnostics", "Diagnostics"));
    out.push("\"></ul></div></div><p class=\"pg-keys\" id=\"pg-keys\">");
    util_push_esc(out, pg(loc, "keys", ""));
    out.push("</p></div>");
    // The examples (and the default program), for the wasm editor.
    struct Value all = Value::object();
    all.object_set("default", Value::from_str(code.as_ptr()));
    all.object_set("examples", examples.clone());
    struct String json = value_to_json(&all);
    json.replace_all("</", "<\\/");
    out.push("<script type=\"application/json\" id=\"pg-data\">");
    out.push_str(&json);
    out.push("</script>");
    json.free();
    all.free();
    code.free();
    out.push("<div class=\"vp-doc pg-doc\">");
    out.push_str(&page.html);
    out.push("</div>");
}

// ── common ───────────────────────────────────────────────────────────────────

static void common(const &Site site, const &Locale loc, &PageView v) {
    ?&Value lv = loc.data.object_get("labels");
    const &Value empty = &loc.data;
    v.lang = String::from(util_vstr(&loc.data, "lang", "en"));
    v.description = String::from(util_vstr(&loc.data, "description", ""));
    v.base = site.base.clone();
    v.home_href = String::new();
    link_rewrite(site, loc.prefix.as_ptr(), &v.home_href);
    v.logo_src = site.base.clone();
    v.logo_src.push("Logo.svg");
    v.site_title = String::from(util_vstr(&loc.data, "title", "SafeC"));
    v.github = String::from(util_vstr(&site.cfg, "repo", ""));
    v.client_js = site.base.clone();
    v.client_js.push("assets/site.js");
    v.css = site.base.clone();
    v.css.push("assets/style.css");
    v.locale_key = loc.key.clone();
    v.locale_prefix = loc.prefix.clone();
    ?&Value footer = loc.data.object_get("footer");
    match (footer) {
        case some(f): {
            v.footer_message = String::from(util_vstr(f, "message", ""));
            v.footer_copyright = String::from(util_vstr(f, "copyright", ""));
        }
        case null: { v.footer_message = String::new(); v.footer_copyright = String::new(); }
    }
    match (lv) {
        case some(l): { empty = l; }
        case null: { }
    }
    v.outline_label    = String::from(util_vstr(empty, "outline", "On this page"));
    v.menu_label       = String::from(util_vstr(empty, "sidebarMenu", "Menu"));
    v.search_label     = String::from(util_vstr(empty, "search", "Search"));
    v.search_placeholder = String::from(util_vstr(empty, "searchPlaceholder", "Search docs"));
    v.no_results       = String::from(util_vstr(empty, "noResults", "No results for"));
    v.copied           = String::from(util_vstr(empty, "copied", "Copied"));
    v.lang_label       = String::from(util_vstr(empty, "langMenu", "Change language"));
    v.theme_label      = String::from(util_vstr(empty, "darkMode", "Appearance"));
    v.return_top_label = String::from(util_vstr(empty, "returnToTop", "Return to top"));
    v.skip_label       = String::from(util_vstr(empty, "skipToContent", "Skip to content"));
    v.not_found_title  = String::from(util_vstr(empty, "notFoundTitle", "PAGE NOT FOUND"));
    v.not_found_quote  = String::from(util_vstr(empty, "notFoundQuote", ""));
    v.not_found_link   = String::from(util_vstr(empty, "notFoundLink", "Take me home"));
    v.head_extra = String::new();
    v.nav = String::new();
    v.locale_menu = String::new();
    v.sidebar = String::new();
    v.toc = String::new();
    v.content = String::new();
    v.prev_next = String::new();
    v.crumbs = String::new();
    v.version_menu = String::new();
    v.footer_cols = String::new();
    v.page_script = String::new();
}

void view_build(const &Site site, const &Vec<struct Page> pages, unsigned long idx, const &Value examples, &PageView v) {
    &Page page = pages.at(idx);
    &Locale loc = site.locales.at(page.locale);
    common(site, loc, v);
    v.title = page.title.clone();
    struct String st = String::from(util_vstr(&loc.data, "title", "SafeC"));
    if (v.title.len == 0UL) { v.title.push_str(&st); }
    else if (!v.title.eq(&st)) { v.title.push(" | "); v.title.push_str(&st); }
    st.free();
    const &char summary = util_vstr(&page.front, "summary", util_vstr(&page.front, "description", ""));
    struct String sm = String::from(summary);
    if (sm.len > 0UL) { v.description.clear(); v.description.push_str(&sm); }
    sm.free();
    v.page_class = String::from(page_layout(page));
    build_head(site, loc, (const ?&Page)page, &v.head_extra);
    build_nav(site, loc, page, &v.nav);
    build_locale_menu(site, pages, page.locale, page, &v.locale_menu);
    build_footer_cols(site, loc, page, &v.footer_cols);
    if (v.page_class.eq_cstr("doc")) {
        build_sidebar(site, loc, page, &v.sidebar);
        build_toc(page, &v.toc);
        build_prev_next(site, loc, page, &v.prev_next);
        build_crumbs(site, loc, page, &v.crumbs);
        build_version_menu(site, loc, &v.version_menu);
        v.content.push_str(&page.html);
    } else if (v.page_class.eq_cstr("post")) {
        build_post(site, loc, page, &v.content);
    } else if (v.page_class.eq_cstr("playground")) {
        build_playground(site, loc, page, examples, &v.content);
        v.page_script.push("<script type=\"module\" src=\"");
        v.page_script.push_str(&site.base);
        v.page_script.push("assets/playground.js\"></script>");
    } else {
        v.content.push_str(&page.html);
    }
}

void view_build_404(const &Site site, unsigned long locale, &PageView v) {
    &Locale loc = site.locales.at(locale);
    common(site, loc, v);
    v.title = String::from("404 | ");
    v.title.push(util_vstr(&loc.data, "title", "SafeC"));
    v.page_class = String::from("not-found");
    build_head(site, loc, (const ?&Page)null, &v.head_extra);
    // Other locales' strings, swapped in by the client when the missing
    // URL is under that locale's prefix.
    for (unsigned long k = 0UL; k < site.locales.len; k = k + 1UL) {
        if (k == locale) { continue; }
        &Locale l = site.locales.at(k);
        ?&Value lv = l.data.object_get("labels");
        const &Value labels = &l.data;
        match (lv) { case some(x): { labels = x; } case null: { } }
        struct String pre = String::new();
        link_rewrite(site, l.prefix.as_ptr(), &pre);
        v.content.push("<div class=\"nf-alt\" hidden data-prefix=\"");
        util_push_esc(&v.content, pre.as_ptr());
        v.content.push("\" data-lang=\"");
        util_push_esc(&v.content, util_vstr(&l.data, "lang", ""));
        v.content.push("\" data-title=\"");
        util_push_esc(&v.content, util_vstr(labels, "notFoundTitle", ""));
        v.content.push("\" data-quote=\"");
        util_push_esc(&v.content, util_vstr(labels, "notFoundQuote", ""));
        v.content.push("\" data-link=\"");
        util_push_esc(&v.content, util_vstr(labels, "notFoundLink", ""));
        v.content.push("\"></div>");
        pre.free();
    }
    // The language menu on 404 just points at each locale's home.
    for (unsigned long k = 0UL; k < site.locales.len; k = k + 1UL) {
        &Locale l = site.locales.at(k);
        v.locale_menu.push("<a class=\"locale-link\"");
        href(site, &v.locale_menu, l.prefix.as_ptr());
        v.locale_menu.push(">");
        util_push_esc(&v.locale_menu, util_vstr(&l.data, "label", ""));
        v.locale_menu.push("</a>");
    }
    // Header nav without a current page: a dummy route matches nothing.
    struct Page none = page_new(site, "__404__.md");
    build_nav(site, loc, &none, &v.nav);
    build_footer_cols(site, loc, &none, &v.footer_cols);
    none.route.free(); none.url.free(); none.src.free(); none.out.free();
    none.front.free(); none.body_md.free(); none.html.free(); none.title.free();
    none.headings.free(); none.sections.free();
}

void view_free(struct PageView v) {
    drop(v);   // every string it holds
}
