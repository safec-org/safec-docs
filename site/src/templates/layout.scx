// safec-site — page templates (scx: SafeC's JSX-style HTML templating).
//
// Templates only interpolate: {x} is HTML-escaped, {!x} is inserted raw
// (the HTML fragments view.sc prebuilt). The shared pieces (header,
// footer, search dialog) are built first and spliced into each layout.
#include "site.h"

static const char* ICON_GITHUB() {
    return "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.6.2 2.9.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3\"/></svg>";
}

static const char* ICON_SEARCH() {
    return "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" d=\"m21 21-4.3-4.3M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z\"/></svg>";
}

static const char* ICON_THEME() {
    return "<svg class=\"sun\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\" fill=\"currentColor\"/><path stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg>"
           "<svg class=\"moon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z\"/></svg>";
}

static const char* ICON_LANG() {
    return "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" d=\"M4 5h8M8 3v2m2.5 0c-1 4-3.5 7-6.5 9m2-5c1 2 3 4 5 5m2 7 4-10 4 10m-6.8-3h5.6\"/></svg>";
}

// Header + mobile menu button: shared by every layout.
static struct String chrome_header(const &PageView v) {
    return <header class="vp-header">
        <div class="header-inner">
            <a class="brand" href={v.home_href.as_ptr()}><img class="logo" src={v.logo_src.as_ptr()} alt="" width="24" height="24"/><span>{v.site_title.as_ptr()}</span></a>
            <button class="search-btn" type="button" data-action="search" aria-label={v.search_label.as_ptr()}>{!ICON_SEARCH()}<span class="search-label">{v.search_label.as_ptr()}</span><kbd>/</kbd></button>
            <nav class="nav" aria-label="Main">{!v.nav.as_ptr()}</nav>
            <div class="nav-group locale"><button class="nav-group-btn icon" type="button" aria-expanded="false" aria-label={v.lang_label.as_ptr()}>{!ICON_LANG()}<span class="caret"></span></button><div class="nav-menu">{!v.locale_menu.as_ptr()}</div></div>
            <button class="icon-btn theme-toggle" type="button" data-action="theme" title={v.theme_label.as_ptr()} aria-label={v.theme_label.as_ptr()}>{!ICON_THEME()}</button>
            <a class="icon-btn" href={v.github.as_ptr()} target="_blank" rel="noreferrer" aria-label="GitHub">{!ICON_GITHUB()}</a>
            <button class="icon-btn menu-toggle" type="button" data-action="menu" aria-label={v.menu_label.as_ptr()} aria-expanded="false" aria-controls="sidebar"><span class="burger"></span></button>
        </div>
    </header>;
}

static struct String chrome_footer(const &PageView v) {
    return <footer class="vp-footer">
        <p>{v.footer_message.as_ptr()}</p>
        <p>{v.footer_copyright.as_ptr()}</p>
    </footer>;
}

static struct String chrome_search(const &PageView v) {
    return <div class="search-dialog" id="search" hidden role="dialog" aria-modal="true" aria-label={v.search_label.as_ptr()} data-empty={v.no_results.as_ptr()}>
        <div class="search-panel">
            <input class="search-input" type="search" autocomplete="off" spellcheck="false" placeholder={v.search_placeholder.as_ptr()} aria-label={v.search_label.as_ptr()}/>
            <ul class="search-results" role="listbox"></ul>
            <p class="search-empty" hidden></p>
        </div>
    </div>;
}

static struct String doc_body_(const &PageView v, const &String header, const &String footer, const &String search) {
    return <body class={v.page_class.as_ptr()} data-locale={v.locale_key.as_ptr()} data-base={v.base.as_ptr()} data-copied={v.copied.as_ptr()}>
        <a class="skip-link" href="#main">{v.skip_label.as_ptr()}</a>
        {!header.as_ptr()}
        <div class="sidebar-backdrop" data-action="menu"></div>
        <aside class="sidebar" id="sidebar"><nav class="sb-nav" aria-label={v.menu_label.as_ptr()}>{!v.sidebar.as_ptr()}</nav><div class="sb-mobile-nav">{!v.nav.as_ptr()}</div></aside>
        <div class="layout">
            <main class="content" id="main">
                <div class="vp-doc">{!v.content.as_ptr()}</div>
                {!v.prev_next.as_ptr()}
            </main>
            <aside class="aside">
                <nav class="outline" aria-labelledby="outline-title">
                    <p class="outline-title" id="outline-title">{v.outline_label.as_ptr()}</p>
                    <ul class="toc">{!v.toc.as_ptr()}</ul>
                    <a class="to-top" href="#">{v.return_top_label.as_ptr()}</a>
                </nav>
            </aside>
        </div>
        {!footer.as_ptr()}
        {!search.as_ptr()}
        <script type="module" src={v.client_js.as_ptr()}></script>
    </body>;
}

static struct String home_body_(const &PageView v, const &String header, const &String footer, const &String search) {
    return <body class="home" data-locale={v.locale_key.as_ptr()} data-base={v.base.as_ptr()} data-copied={v.copied.as_ptr()}>
        <a class="skip-link" href="#main">{v.skip_label.as_ptr()}</a>
        {!header.as_ptr()}
        <div class="sidebar-backdrop" data-action="menu"></div>
        <aside class="sidebar mobile-only" id="sidebar"><div class="sb-mobile-nav">{!v.nav.as_ptr()}</div></aside>
        <main class="home-main" id="main">
            <section class="hero"><div class="hero-copy">{!v.hero.as_ptr()}</div><img class="hero-logo" src={v.logo_src.as_ptr()} alt="SafeC"/></section>
            <section class="features">{!v.features.as_ptr()}</section>
            <div class="vp-doc home-doc">{!v.content.as_ptr()}</div>
        </main>
        {!footer.as_ptr()}
        {!search.as_ptr()}
        <script type="module" src={v.client_js.as_ptr()}></script>
    </body>;
}

static struct String not_found_body_(const &PageView v, const &String header, const &String search) {
    return <body class="not-found" data-locale={v.locale_key.as_ptr()} data-base={v.base.as_ptr()}>
        {!header.as_ptr()}
        <main class="nf" id="main">
            <p class="nf-code">404</p>
            <h1 class="nf-title">{v.not_found_title.as_ptr()}</h1>
            <blockquote class="nf-quote">{v.not_found_quote.as_ptr()}</blockquote>
            <a class="button brand nf-home" href={v.home_href.as_ptr()}>{v.not_found_link.as_ptr()}</a>
            {!v.content.as_ptr()}
        </main>
        {!search.as_ptr()}
        <script type="module" src={v.client_js.as_ptr()}></script>
    </body>;
}

static struct String document_(const &PageView v, const &String body) {
    // The inline script applies the saved/OS color scheme before first
    // paint (no flash); it is the only JavaScript besides the wasm loader.
    return <!doctype html>
    <html lang={v.lang.as_ptr()}>
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width,initial-scale=1"/>
        <title>{v.title.as_ptr()}</title>
        <meta name="description" content={v.description.as_ptr()}/>
        <meta name="color-scheme" content="light dark"/>
        <link rel="stylesheet" href={v.css.as_ptr()}/>
        <script>(()=>{try{const t=localStorage.getItem('safec-theme');const d=t?t==='dark':matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.classList.toggle('dark',d)}catch(e){}})()</script>
        {!v.head_extra.as_ptr()}
    </head>
    {!body.as_ptr()}
    </html>;
}

// kind: 0 doc, 1 home, 2 not found.
static struct String page(const &PageView v, int kind) {
    struct String header = chrome_header(v);
    struct String footer = chrome_footer(v);
    struct String search = chrome_search(v);
    struct String body;
    if (kind == 1) { body = home_body_(v, &header, &footer, &search); }
    else if (kind == 2) { body = not_found_body_(v, &header, &search); }
    else { body = doc_body_(v, &header, &footer, &search); }
    struct String doc = document_(v, &body);
    doc.push_char('\n');
    header.free(); footer.free(); search.free(); body.free();
    return doc;
}

struct String tpl_doc(const &PageView v)       { return page(v, 0); }
struct String tpl_home(const &PageView v)      { return page(v, 1); }
struct String tpl_not_found(const &PageView v) { return page(v, 2); }
